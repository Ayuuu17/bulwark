# Copy to .env and fill in before deploying. Never commit the real .env.
# Load it with your platform's secret manager, or `set -a; source .env; set +a` locally.

# --- required in production ---
# Long random value. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it invalidates every customer's domain verification, so set it once and keep it.
SECRET_KEY=
# Public address of your site, used in reset emails and security.txt.
PUBLIC_URL=https://yourdomain.com

# --- business details shown in the legal pages ---
APP_NAME=Bulwark
LEGAL_ENTITY=Your Company Ltd
CONTACT_EMAIL=hello@yourdomain.com
SECURITY_EMAIL=security@yourdomain.com
PRIVACY_EMAIL=privacy@yourdomain.com
GOVERNING_LAW=Texas, USA
LEGAL_EFFECTIVE_DATE=2026-10-20
HOSTING_PROVIDER=Your hosting provider
EMAIL_PROVIDER=Your email provider
# Bump when you materially change the Terms; the accepted version is stored per user.
TERMS_VERSION=2026-10-20

# --- email (password resets). Any SMTP provider: Postmark, Resend, SES, Mailgun... ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Bulwark <noreply@yourdomain.com>

# --- AI deep review (optional). Leave AI_MODEL empty to turn it off. ---
# OpenAI: https://api.openai.com/v1 · Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter: https://openrouter.ai/api/v1 · Ollama (local, private): http://localhost:11434/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Shown in the Privacy Policy so customers know who sees their code.
AI_PROVIDER_NAME=
AI_MAX_FILES=20
AI_BATCH_CHARS=24000
AI_CONCURRENCY=2
AI_TIMEOUT=300

# --- limits and retention ---
SCANS_PER_HOUR=20
MAX_CODE_UPLOAD_MB=100
VERIFICATION_TTL_DAYS=30
# Reports are deleted automatically after this many days (0 = keep until the user deletes them).
RETENTION_DAYS=90
DATA_DIR=/data

# --- NEVER set this in production: it would let anyone scan your internal network ---
# ALLOW_PRIVATE_TARGETS=1
